{
  "name": "rule-lens",
  "displayName": "RuleLens",
  "description": "Show scoped review findings in VS Code and export the same findings for agents.",
  "publisher": "rule-lens-local",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=18.3",
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "main": "./extension.cjs",
  "bin": {
    "rule-lens": "./cli.cjs"
  },
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "configuration": {
      "title": "RuleLens",
      "properties": {
        "ruleLens.nodePath": {
          "type": "string",
          "default": "",
          "description": "Standalone Node executable path or command. Empty uses RULE_LENS_NODE, then node from PATH."
        },
        "ruleLens.timeoutMs": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 900000,
          "description": "Scan timeout in milliseconds. Zero uses execution.timeoutMs from rule-lens.json."
        }
      }
    },
    "commands": [
      { "command": "ruleLens.refresh", "title": "RuleLens: Refresh" },
      { "command": "ruleLens.showFileFindings", "title": "RuleLens: Show File Findings" },
      { "command": "ruleLens.clear", "title": "RuleLens: Clear" }
    ]
  },
  "scripts": {
    "test": "node --test",
    "package:extension": "python3 scripts/vsix.py package",
    "install:extension": "python3 scripts/vsix.py install"
  }
}
